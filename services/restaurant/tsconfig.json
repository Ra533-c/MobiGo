{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // Yahan change karein (Line 8 se 10 ke aas paas hoga)
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    // For nodejs:
    "lib": ["ES2020"],
    "types": ["node"],

    // Other Outputs
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,

    // Recommended Options
    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop" :true,
    "resolveJsonModule": true,
    
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
