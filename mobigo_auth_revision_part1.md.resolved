### 6️⃣ [controllers/auth.ts](file:///c:/Users/rajni/mobigo/services/auth/src/controllers/auth.ts) — Business Logic 🎮

```typescript
import User from "../model/User.js";
import jwt from "jsonwebtoken";
import TryCatch from "../middlewares/trycatch.js";
import { AuthenticatedRequest } from "../middlewares/isAuth.js";

// ═══════════════ LOGIN FUNCTION ═══════════════
export const loginUser = TryCatch(async (req, res) => {

  const { email, name, image } = req.body;
  // ^ Destructuring: req.body = {email: "a@b.com", name: "Rajni", image: "url"}
  // Isko 3 alag variables me tod diya

  let user = await User.findOne({ email: email });
  // ^ DB me check karo: Is email wala user pehle se hai kya?
  // "let" isliye use kiya kyunki agar user nahi mila toh naya banayenge

  if (!user) {
    user = await User.create({
      name,
      email,
      image,
      // role: default null (schema me define hai)
    });
    // ^ Naya user create karo DB me
  }

  const token = jwt.sign(
    { user },                              // Payload: kya data encode karna hai
    process.env.JWT_SECRET as string,      // Secret key se sign karo
    { expiresIn: "15d" }                   // 15 din baad expire hoga
  );
  // ^ JWT Token = Encoded string jisme user data hai
  // Login ke baad ye token client ko dete hain
  // Client har request me ye bhejega (Authorization header me)

  res.status(200).json({
    message: "Loging successfull",
    token: token,    // Client ise save karega (localStorage/cookie)
    user: user,      // User data bhi bhej do display ke liye
  });
});

// ═══════════════ ROLE SYSTEM ═══════════════
const allowedRoles = ["customer", "admin", "seller"] as const;
// ^ "as const" = Readonly tuple. Push/modify nahi ho sakta.
// Type: readonly ["customer", "admin", "seller"]

type Role = (typeof allowedRoles)[number];
// ^ Magic line! Array se Union Type nikala:
// Result: type Role = "customer" | "admin" | "seller"

// ═══════════════ ADD ROLE FUNCTION ═══════════════
export const addUserRole = TryCatch(async (req: AuthenticatedRequest, res) => {
  // ^ req ko AuthenticatedRequest type diya kyunki isme req.user hai
  //   (isAuth middleware ne set kiya tha)

  if (!req.user?._id) {
  // ^ Optional chaining (?.) = Agar req.user exist kare TABHI ._id check karo
  //   Warna undefined return kar do (crash nahi hoga)
    return res.status(401).json({
      message: "Unauthoriszed user !",
    });
  }

  const { role } = req.body as { role: Role };
  // ^ req.body se role nikala
  // "as { role: Role }" = TS ko bata rahe hain ki body me Role type ka data hai

  if(!allowedRoles.includes(role)) {
  // ^ Check: Kya bheja gaya role hamari list me hai?
  //   "hacker" bheja toh false → error response
    return res.status(401).json({
      message: "Invalid role !"
    });
  }

  const user = await User.findByIdAndUpdate(
    req.user._id,          // Kis user ko update karna hai
    { role },              // Kya update karna hai (shorthand: {role: role})
    { new: true }          // Updated document return karo (purana nahi)
  );

  if(!user) {
    return res.status(404).json({
      message: "User not found!"
    });
  }

  const token = jwt.sign(
    { user },
    process.env.JWT_SECRET as string,
    { expiresIn: "15d" }
  );
  // ^ Naya token banaya updated user data ke saath
  // Purana token me role nahi tha, naye me hai!

  res.json({
    user,
    token
  });
});
```

