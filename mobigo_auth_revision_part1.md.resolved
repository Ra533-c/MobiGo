### 5️⃣ [middlewares/isAuth.ts](file:///c:/Users/rajni/mobigo/services/auth/src/middlewares/isAuth.ts) — Authentication Guard 🔒

```typescript
import { Request, Response, NextFunction } from "express";
import jwt, { JwtPayload } from "jsonwebtoken";
import { IUser } from "../model/User.js";

export interface AuthenticatedRequest extends Request {
// ^ Express ka default Request type me "user" property NAHI hai.
// Isliye humne ek CUSTOM type banaya jo Request ko EXTEND karta hai.
// Ab AuthenticatedRequest = Request + user property!
    user?: IUser | null;
    // ? = Optional (ho bhi sakta hai, na bhi ho)
    // IUser | null = User object ya null
}

export const isAuth = async (
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
): Promise<void> => {
// ^ Return type Promise<void> = Ye function kuch return nahi karta,
//   bas req.user set karke next() call karta hai

    try {
        const authHeader = req.headers.authorization;
        // ^ Client request me "Authorization: bearer eyJhb..." header bhejta hai

        if(!authHeader || !authHeader.startsWith("bearer ")) {
        // ^ Agar header hi nahi hai YA "bearer " se start nahi hota
            res.status(401).json({
                message: "Please Login - No auth header",
            });
            return; // Yahan function khatam, aage nahi jayega
        }

        const token = authHeader.split(" ")[1];
        // ^ "bearer eyJhbGci..." → split(" ") → ["bearer", "eyJhbGci..."]
        // [1] = "eyJhbGci..." (actual token)

        if(!token) {
            res.status(401).json({
                message: "Please Login - No token",
            });
            return;
        }

        const decodedToken = jwt.verify(
            token,
            process.env.JWT_SECRET as string
        ) as JwtPayload;
        // ^ Token ko verify karo JWT_SECRET se
        // Agar token valid hai toh decoded data milega
        // Agar expired/tampered hai toh ERROR throw hoga → catch me jayega
        // "as JwtPayload" = Type assertion

        if(!decodedToken || !decodedToken.user) {
            res.status(401).json({
                message: "Please Login - Invalid token",
            });
            return;
        }

        req.user = decodedToken.user;
        // ^ 🔥 MOST IMPORTANT LINE!
        // Token me se user data nikala aur req object pe set kiya
        // Ab aage ke controllers me req.user se user mil jayega!

        next();
        // ^ "Sab theek hai, agle middleware/controller ko bhejo"

    } catch(error: any) {
        res.status(500).json({
            Message: "Please Login!"
        });
    }
}
```

**🎯 Middleware Flow:**
```
Request → isAuth → (token check) → ✅ next() → Controller
                                  → ❌ 401 Error Response
```

