### 7️⃣ [routes/auth.ts](file:///c:/Users/rajni/mobigo/services/auth/src/routes/auth.ts) — URL Endpoints 🛤️

```typescript
import express from "express";
import { addUserRole, loginUser } from "../controllers/auth.js";
import { isAuth } from "../middlewares/isAuth.js";

const router = express.Router();
// ^ Mini express app jo sirf routes handle kare

router.post("/login", loginUser);
// ^ POST /api/auth/login → loginUser controller
// Koi bhi bina token ke login kar sakta hai (Public route)

router.put("/add/role", isAuth, addUserRole);
// ^ PUT /api/auth/add/role → Pehle isAuth check → Fir addUserRole
// isAuth = Middleware (token verify karo)
// addUserRole = Controller (role update karo)
// ⚠️ Order matters! isAuth pehle chalega, pass hone pe hi addUserRole chalega

export default router;
```
